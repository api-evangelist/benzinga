            "description": {
              "content": "Returns economic calendar data including economic indicators, releases, and reports from various countries. Includes actual values, consensus estimates, and prior values for economic events such as GDP, employment data, inflation metrics, and more.",
              "type": "text/plain"
            },
            "url": {

          "request": {
            "name": "Returns guidance data",
            "description": {
              "content": "Returns company guidance data including forward-looking earnings and revenue projections provided by company management. Includes EPS guidance ranges (min/max), revenue guidance ranges, and comparisons to prior guidance. Guidance is crucial for understanding management's expectations for future performance.",
              "type": "text/plain"
            },

                "description": "Search keys type"
              },
              {
                "name": "search_keys",
                "value": "",
                "type": "query",
                "description": "Search keys"
              },
              {
                "name": "display",
                "value": "",
                "type": "query",
                "description": "Display"
              },
              {
                "name": "view_type",
                "value": "",
                "type": "path",
                "description": "Response format: 'filings' returns grouped filing view with transactions nested, 'transactions' returns flattened individual transaction view"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "query"
            }
          },
          "docs": "Returns insider transaction data from SEC Form 4 filings. Use /filings endpoint for grouped filing view (transactions nested under each filing) or /transactions endpoint for flattened individual transaction view. Both endpoints support the same query parameters."
        },

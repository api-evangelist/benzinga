          "name": "Search Logos",
          "request": {
            "name": "Search Logos",
            "description": {
              "content": "Search Logos",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "logos",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "search_keys",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of security identifiers. Maximum 100 identifiers. Type depends on search_keys_type parameter."
                },
                {
                  "disabled": false,
                  "key": "search_keys_type",
                  "value": "<string>",
                  "description": "Type of identifier being searched. Supported types: symbol (default), cik, cusip, isin"
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of logo fields to return. Maximum 12 fields. Available: logo_light, logo_dark, logo_vector_light, logo_vector_dark, mark_light, mark_dark, mark_vector_light, mark_vector_dark, mark_composite_light, mark_composite_dark, mark_vector_composite_light, mark_vector_composite_dark, colors"
                },
                {
                  "disabled": false,
                  "key": "composite_auto",
                  "value": "<boolean>",
                  "description": "If true and no logo exists, generates a composite image based on company name and brand colors"
                },
                {
                  "disabled": false,
                  "key": "composite_radius",
                  "value": "<integer>",
                  "description": "Border radius for composite images in percentage. Range 0-50 where 50 creates a circle. Default: 0"
                },
                {
                  "disabled": false,
                  "key": "scale",
                  "value": "<string>",
                  "description": "Scale image dimensions in WIDTHxHEIGHT format (e.g., 300x300). Images scale down only, never up. Default: 300x300"
                },
                {
                  "disabled": false,
                  "key": "max_width",
                  "value": "<string>",
                  "description": "Maximum width constraint for scaled images in pixels"
                },
                {
                  "disabled": false,
                  "key": "flutter_compatible",
                  "value": "<boolean>",
                  "description": "If true, adds flutter_compatible=true query parameter to SVG URLs for flutter_svg library compatibility"
                }

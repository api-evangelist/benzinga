        {
          "id": "c1d9eb9e-4e3f-4861-a870-999cbd49297b",
          "name": "Bulk logos sync",
          "request": {
            "name": "Bulk logos sync",
            "description": {
              "content": "Bulk logos sync. Walks the full logo dataset via page/pagesize (optionally narrowed by updated_since); it is not a per-identifier lookup. To fetch logos for specific securities, use GET /api/v2/logos/search.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2.1",
                "logos",
                "sync"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "search_keys",
                  "value": "<string>",
                  "description": "Only applies to v2.1 exchange logos (search_keys_type=exchange): comma-separated list of exchange MIC codes to filter by."
                },
                {
                  "disabled": false,
                  "key": "search_keys_type",
                  "value": "<string>",
                  "description": "Set to exchange to sync v2.1 exchange logos (filtered by search_keys). Omit for the default bulk security-logo sync."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>,<string>",
                  "description": "(Required) Comma-separated list of logo fields to return. Maximum 12 fields. Available: logo_light, logo_dark, logo_vector_light, logo_vector_dark, mark_light, mark_dark, mark_vector_light, mark_vector_dark, mark_composite_light, mark_composite_dark, mark_vector_composite_light, mark_vector_composite_dark, colors"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number for pagination. Used with pagesize for bulk sync operations."
                },
                {
                  "disabled": false,
                  "key": "pagesize",
                  "value": "<integer>",
                  "description": "Number of results per page. Default: 100. Maximum: 1000"
                },
                {
                  "disabled": false,
                  "key": "updated_since",
                  "value": "<string>",
                  "description": "Unix timestamp (UTC). Returns logos updated after this timestamp."
                },
                {
                  "disabled": false,
                  "key": "scale",
                  "value": "<string>",
                  "description": "Scale image dimensions in WIDTHxHEIGHT format (e.g., 300x300). Images scale down only, never up. Default: 300x300"
                },
                {
                  "disabled": false,
                  "key": "composite_radius",
                  "value": "<integer>",
                  "description": "Border radius for composite images in percentage. Range 0-50 where 50 creates a circle. Default: 0"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {

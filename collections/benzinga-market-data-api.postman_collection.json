        {
          "id": "a63019ce-8c26-420b-887b-fcdb34e423e4",
          "name": "Historical Price Bars",
          "request": {
            "name": "Historical Price Bars",
            "description": {
              "content": "Retrieves historical OHLCV (Open, High, Low, Close, Volume) price bar data for specified securities. Returns aggregated price data based on the specified interval. Supports multiple ticker symbols and various time ranges including relative dates.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "bars"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of stock ticker symbols (e.g., AAPL,MSFT,TSLA). Required."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "(Required) Start date/time for bars. Formats: YYYY-MM-DD, YYYY-MM-DDTHH:MM:SS, YTD (year-to-date), or relative values like 1MONTH/1m/1M, 1WEEK/1w/1W, 1DAY/1d/1D. Required."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "End date/time for bars. Format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS. Defaults to current date/time if not specified."
                },
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<string>",
                  "description": "Time bucket interval for aggregating price bars. Supported values: 1m (1 minute), 5m (5 minutes), 15m (15 minutes), 30m (30 minutes), 1h (1 hour), 1d (1 day), 1w (1 week), 1M (1 month). Default: 1d"
                },
                {
                  "disabled": false,
                  "key": "session",
                  "value": "<string>",
                  "description": "Trading session filter. Supported values: ANY (all sessions), PRE_MARKET (pre-market trading), REGULAR (regular trading hours), AFTER_MARKET (after-hours trading). Default: ANY"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",

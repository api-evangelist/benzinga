                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of stock ticker symbols (e.g., AAPL,MSFT,TSLA). Required."
                },
                {
                  "disabled": false,
                  "key": "finraReport",
                  "value": "<boolean>",
                  "description": "Include FINRA short interest report data. Default: false"

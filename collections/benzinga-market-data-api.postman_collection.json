          "name": "Short Interest Data",
          "request": {
            "name": "Short Interest Data",
            "description": {
              "content": "Retrieves short interest data for specified securities. Includes information about shares sold short, days to cover, and short interest ratios. Supports optional FINRA report data and date range filtering.",

          "name": "Press Releases",
          "request": {
            "name": "Press Releases",
            "description": {
              "content": "This REST API returns structured data for press releases. For optimal performance, limit the scope of the query using parameters such as tickers, date, and channels, or use updatedSince for deltas. Page offsets are limited from 0 - 100000.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "news"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Page offset. For optimization, performance and technical reasons, page offsets are limited from 0 - 100000. Limit the query results by other parameters such as date."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "15",
                  "description": "Number of results returned. Maximum 100."
                },
                {
                  "disabled": false,
                  "key": "displayOutput",
                  "value": "headline",
                  "description": "Specify headline only (headline), headline + teaser (abstract), or headline + full body (full) text"
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<string>",
                  "description": "The date to query for news. Shorthand for dateFrom and dateTo if they are the same. Format: yyyy-mm-dd"
                },
                {
                  "disabled": false,
                  "key": "dateFrom",
                  "value": "<string>",
                  "description": "Date to query from point in time. Sorted by published date. Format: yyyy-mm-dd"
                },
                {
                  "disabled": false,
                  "key": "dateTo",
                  "value": "<string>",
                  "description": "Date to query to point in time. Sorted by published date. Format: yyyy-mm-dd"
                },
                {
                  "disabled": false,
                  "key": "updatedSince",
                  "value": "<integer>",
                  "description": "The last updated Unix timestamp (UTC) to pull and sort by"
                },
                {
                  "disabled": false,
                  "key": "publishedSince",
                  "value": "<integer>",
                  "description": "The last published Unix timestamp (UTC) to pull and sort by"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Allows control of results sorting. Default is created, DESC. Format: field:direction. Sort Fields: id, created, updated. Sort Order: asc (ascending), desc (descending)"
                },
                {
                  "disabled": false,
                  "key": "isin",
                  "value": "<string>",
                  "description": "One or more ISINs separated by a comma. Maximum 50. Format: csv"
                },
                {
                  "disabled": false,
                  "key": "cusips",
                  "value": "<string>",
                  "description": "One or more CUSIPs separated by a comma. Maximum 50. License agreement required. Format: csv"
                },
                {
                  "disabled": false,
                  "key": "tickers",
                  "value": "<string>",
                  "description": "One or more ticker symbols separated by a comma. Maximum 50. Format: csv"
                },
                {
                  "disabled": false,
                  "key": "primaryTickers",
                  "value": "<string>",
                  "description": "One or more primary ticker symbols separated by a comma. Filters by primary ticker association only. Format: csv"
                },
                {
                  "disabled": false,
                  "key": "channels",
                  "value": "<string>",
                  "description": "One or more channel names or IDs separated by a comma. Format: csv"
                },
                {
                  "disabled": false,
                  "key": "topics",
                  "value": "<string>",
                  "description": "One or more words/phrases separated by a comma; searches Title, Tags, and Body in order of priority. Format: csv"
                },
                {
                  "disabled": false,
                  "key": "topic_group_by",
                  "value": "or",
                  "description": "Logical operator for topics query. Use 'and' to require all topics, 'or' to require any topic"
                },
                {
                  "disabled": false,
                  "key": "authors",
                  "value": "<string>",
                  "description": "One or more authors separated by a comma. Format: csv"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Specify the desired format for the api response"
                },
                {
                  "disabled": false,
                  "key": "importance",
                  "value": "<string>",
                  "description": "Filter by importance level"
                },
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "Filter by region (e.g., 'ca' or 'canada' for Canadian content)"
                }
              ],
              "variable": []
            },

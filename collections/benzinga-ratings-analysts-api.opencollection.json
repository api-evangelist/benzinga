{
  "opencollection": "1.0.0",
  "info": {
    "name": "Analyst Reports Raw Text Analyst Insights ratings_analysts API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "ratings_analysts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ratings Analysts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.benzinga.com/api/v2.1/calendar/ratings/analysts",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page offset. For optimization, performance and technical reasons, page offsets are limited from 0 - 100000. Limit the query results by other parameters such as date. Default is 0"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of results returned. Limit 1000"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Fields"
              },
              {
                "name": "analyst",
                "value": "",
                "type": "query",
                "description": "Analyst"
              },
              {
                "name": "analyst_name",
                "value": "",
                "type": "query",
                "description": "Analyst name"
              },
              {
                "name": "firm",
                "value": "",
                "type": "query",
                "description": "Firm"
              },
              {
                "name": "firm_name",
                "value": "",
                "type": "query",
                "description": "Firm name"
              },
              {
                "name": "updated",
                "value": "",
                "type": "query",
                "description": "Records last Updated Unix timestamp (UTC). This will force the sort order to be Greater Than or Equal to the timestamp indicated"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "query"
            }
          },
          "docs": "Returns the full list of analysts that are providing ratings"
        }
      ]
    }
  ],
  "bundled": true
}
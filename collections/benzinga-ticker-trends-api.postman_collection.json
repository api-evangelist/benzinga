          "name": "Get Ticker Trend Data",
          "request": {
            "name": "Get Ticker Trend Data",
            "description": {
              "content": "Retrieve trending data for specific tickers, including rank and change. Returns aggregated trend scores and activity levels across different time intervals.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "trending-tickers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<string>",
                  "description": "(Required) Time interval for aggregating trend data. Supported values: 10m (10 minutes), 1h (1 hour), 1d (1 day). Required."
                },
                {
                  "disabled": false,
                  "key": "tickers",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of stock ticker symbols (e.g., AAPL,MSFT,TSLA) to retrieve trend data for. Required."
                },
                {
                  "disabled": false,
                  "key": "source",
                  "value": "<string>",
                  "description": "(Required) Data source filter for trend calculation. Supported values: all (all sources combined), clickstream (user interaction data), logo (logo request data). Required."
                },
                {
                  "disabled": false,
                  "key": "timeframe",
                  "value": "<string>",
                  "description": "Time window for trend analysis. Optional custom timeframe specification for filtering results by specific date ranges."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number for pagination. Zero-indexed (0 = first page, 1 = second page, etc.). Default: 0"
                },
                {
                  "disabled": false,
                  "key": "pagesize",
                  "value": "<integer>",
                  "description": "Number of results per page. Default: 1000. Maximum: 1000"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
